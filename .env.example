# Copy to .env. Defaults run fully offline with template explanations.
CCR_DATABASE_URL=sqlite:///./data/ccr_xva.db
CCR_CHROMA_PATH=./data/chroma
# Leave the Pinecone key empty to keep the local hashed index. A key makes Pinecone embed the methodology notes.
CCR_PINECONE_API_KEY=
CCR_PINECONE_INDEX=ccr-methodology
CCR_PINECONE_CLOUD=aws
CCR_PINECONE_REGION=us-east-1
CCR_PINECONE_EMBED_MODEL=llama-text-embed-v2
CCR_PINECONE_NAMESPACE=methodology
CCR_LLM_ENABLED=false
CCR_AGENT=adk
CCR_ADK_MODEL=gemini-2.5-flash
CCR_GOOGLE_API_KEY=
CCR_OLLAMA_BASE_URL=http://localhost:11434
CCR_OLLAMA_MODEL=llama3.1:8b
CCR_GROQ_API_KEY=
CCR_GROQ_MODEL=llama-3.1-8b-instant
CCR_LANGFUSE_HOST=
CCR_LANGFUSE_PUBLIC_KEY=
CCR_LANGFUSE_SECRET_KEY=
CCR_API_URL=http://localhost:8000/api/v1
